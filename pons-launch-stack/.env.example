# --- شبکه (Robinhood Chain) ---
RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663

# --- کلیدها (خارج از ریپو نگه دار، هرگز کامیت نکن) ---
# کیف مستر (کریتور): فقط لانچ می‌کند — فی به آن نمی‌رسد
PRIVATE_KEY=0x...
# کیف کلیمر (جدا از کریتور — الگوی موج دوم): این ولت creatorFeeRecipient می‌شود و claim را خودش اجرا می‌کند
CLAIMER_PRIVATE_KEY=0x...
# کیف پرداخت‌کننده‌ی بچ‌بای (payer — معادل ولت تریگری مثل 0x9ef79573 در فارم واقعی)
# اگر خالی بگذاری، batch_buy از PRIVATE_KEY (مستر) استفاده می‌کند — پیشنهاد: ولت سومِ جدا
BATCH_PAYER_PRIVATE_KEY=0x...
# عبارت بازیابی برای تولید ولت‌های کارگر (باندل/دریافت‌کننده‌ها) — اختیاری
MNEMONIC=
# تعداد ولت‌های کارگر/معاف (پیش‌فرض کل تولکیت)
WORKER_COUNT=28
# آفست مشتق‌گیری کارگرها — در همه‌ی مراحل (fund/launch/batch_buy/exit/sell) باید یکی باشد
# فلگ --worker-start روی این مقدار اولویت دارد؛ با launch-file آفست خودکار از رکورد لانچ خوانده می‌شود
WORKER_START=0

# آدرس خزانه برای جمع‌آوری سود (sweep)
TREASURY_ADDRESS=0x...

# --- تنظیمات عملیاتی ---
# جهش اقتصادی پین‌شده‌ی کانفیگ لانچ (تأییدشده در کال‌دیتای شش لانچ موج دوم؛ در صورت خطای LaunchEconomicsMismatch با src/inspect.js به‌روز کن)
EXPECTED_ECONOMICS=0x0a9fc75d4203a33fe660e8fa32c74c3aa41c1fda4bf23d3a39b6bc22a1f8b1ca7
# کارمزد لانچ — فقط fallback وقتی خواندن آنچین لازم است چک: مقدار واقعی همیشه از فکتوری خوانده می‌شود.
# اعمال env به جای مقدار آنچین فقط با فلگ --force-fee-env در launch.js ممکن است (و اگر با آنچین فرق داشته باشد هشدار می‌دهد).
LAUNCH_FEE_ETH=0.0005
# درصد لغزش پیش‌فرض برای تخمین minOut خرید/فروش و پنیک
SLIPPAGE_BPS=800
